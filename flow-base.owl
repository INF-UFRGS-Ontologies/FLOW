        <rdfs:label xml:lang="en">has fluid supplied by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem fluido fornecido por</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso#hasFluidSuppliedBy</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000031 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000031">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000028"/>
        <rdfs:comment xml:lang="en">Relation implying logical return flow from a thing to another.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">retorna fluido para</rdfs:label>
        <rdfs:label xml:lang="en">returns fluid to</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso#returnsFluidTo</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000032 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000032">
