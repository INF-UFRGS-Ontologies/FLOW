        <rdfs:label xml:lang="en">has gas supplied by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem gás fornecido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000011 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000011">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000004"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000005"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000012"/>
        <rdfs:comment xml:lang="en">Relation from a thing feeding air to the thing it is feeding air to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">alimenta ar para</rdfs:label>
        <rdfs:label xml:lang="en">feeds air to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000012 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000012">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000004"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000006"/>
        <rdfs:comment xml:lang="en">Relation from a thing that is fed air to the thing feeding the air.</rdfs:comment>
        <rdfs:label xml:lang="en">has air fed by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem ar alimentado por</rdfs:label>
    </owl:ObjectProperty>
    


