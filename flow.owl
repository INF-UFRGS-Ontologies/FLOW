    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000021 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="pt-br">objeto aberto ao fluxo</rdfs:label>
        <rdfs:label xml:lang="en">open to flow object</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">def. a BFO:Object that is fully connected and allows fluid to flow through it.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000022 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000022">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000034"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                        <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000024"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000021"/>
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000034"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000196"/>
                <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pt-br">objeto de fluxo aberto</rdfs:label>
        <rdfs:label xml:lang="en">open flow object</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">def. a FLOW:StateBasedFlowObject that is open and allows fluid to flow through it.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000023 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000023">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
                        <owl:someValuesFrom rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000034"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="pt-br">estado do objeto de fluxo</rdfs:label>
        <rdfs:label xml:lang="en">flow object state</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">def. a BFO:Quality that is the open/closed state of a FLOW:StateBasedFlowObject.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000024 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000024">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000023"/>
        <owl:disjointWith rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000025"/>
        <rdfs:label xml:lang="pt-br">estado aberto do objeto de fluxo</rdfs:label>
        <rdfs:label xml:lang="en">flow object open state</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">def. a FLOW:FlowObjectState that is an open state.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000025 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000025">
        <rdfs:subClassOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000023"/>
        <rdfs:label xml:lang="pt-br">estado fechado do objeto de fluxo</rdfs:label>
        <rdfs:label xml:lang="en">flow object closed state</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">def. a FLOW:FlowObjectState that is a closed state.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000034 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="pt-br">objeto de fluxo baseado em estado</rdfs:label>
        <rdfs:label xml:lang="en">state-based flow object</rdfs:label>
        <iof-av:naturalLanguageDefinition xml:lang="en">def. a BFO:Object that that is fully connected and may allow fluid to flow through it depending on its state.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


    <!-- https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004 -->

    <owl:Class rdf:about="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://www.inf.ufrgs.br/ontologies/ofl/OFL_0000007"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Functional Location</rdfs:label>
        <rdfs:label xml:lang="pt-br">Local de Instalação</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">ISO 14224:2016 — &apos;a position in a functional hierarchy where a maintainable item is or can be installed&apos;</iof-av:adaptedFrom>
        <iof-av:naturalLanguageDefinition xml:lang="en">A functional location is a site that is a persistent spatial position in an industrial facility hierarchy where a maintainable item is or can be installed, and whose boundaries are determined in relation to delimiting material structures rather than by the equipment that may occupy it.</iof-av:naturalLanguageDefinition>
        <iof-av:naturalLanguageDefinition xml:lang="pt-br">Um local de instalação é um sítio que é uma posição espacial persistente em uma hierarquia de instalação industrial onde um item manutenível está ou pode ser instalado, e cujos limites são determinados em relação a estruturas materiais delimitadoras e não pelo equipamento que possa ocupá-lo.</iof-av:naturalLanguageDefinition>
    </owl:Class>
    


