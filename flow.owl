        <rdfs:comment xml:lang="en">Relation between a thing that is supplying air to the thing it is supplying air to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">fornece ar para</rdfs:label>
        <rdfs:label xml:lang="en">supplies air to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000015 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000015">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000009"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000012"/>
        <rdfs:comment xml:lang="en">Relation between a thing that has air returned to it and the thing returning the air.</rdfs:comment>
        <rdfs:label xml:lang="en">has air returned by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem ar retornado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000016 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000016">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000010"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000012"/>
        <rdfs:comment xml:lang="en">Relation between a thing that has air supplied to it and the thing supplying the air.</rdfs:comment>
        <rdfs:label xml:lang="en">has air supplied by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem ar fornecido por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000017 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000017">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000033"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a logical connection (such as within a business process) but not necessarily a physical one.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">conectado logicamente a</rdfs:label>
        <rdfs:label xml:lang="en">logically connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000017"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a signal exchange connection.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges signal with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca sinal com</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000019 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000019">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000020"/>
        <rdfs:comment xml:lang="en">Relation from a thing sending some signal to the thing it is sending signal to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">envia sinal para</rdfs:label>
        <rdfs:label xml:lang="en">sends signal to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000020 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000020">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018"/>
        <rdfs:comment xml:lang="en">Relation from a thing that receives some signal to the thing sending the signal.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">recebe sinal de</rdfs:label>
        <rdfs:label xml:lang="en">receives signal from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000026 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000026">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000033"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a fluid exchange connection</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges fluid with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca fluido com</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000027 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000027">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000026"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000028"/>
        <rdfs:comment xml:lang="en">Relation from a thing feeding fluid to the thing it is feeding fluid to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">alimenta fluido para</rdfs:label>
        <rdfs:label xml:lang="en">feeds fluid to</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000028 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000028">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000026"/>
        <rdfs:comment xml:lang="en">Relation from a thing that is fed fluid to the thing feeding the fluid.</rdfs:comment>
        <rdfs:label xml:lang="en">has fluid fed by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem fluido alimentado por</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000029 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000029">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000027"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000031"/>
        <rdfs:comment xml:lang="en">Relation between a thing that has fluid returned to it and the thing returning the fluid.</rdfs:comment>
        <rdfs:label xml:lang="en">has fluid returned by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem fluido retornado por</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000030 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000030">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000027"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000032"/>
        <rdfs:comment xml:lang="en">Relation between a thing that has fluid supplied to it and the thing supplying the fluid.</rdfs:comment>
        <rdfs:label xml:lang="en">has fluid supplied by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem fluido fornecido por</rdfs:label>
        <iof-av:adaptedFrom xml:lang="en">http://www.w3id.org/fso</iof-av:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000031 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000031"/>
    


