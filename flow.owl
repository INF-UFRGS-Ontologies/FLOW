                    <owl:Class>
                        <owl:complementOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000006"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
