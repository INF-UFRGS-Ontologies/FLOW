        <rdfs:comment xml:lang="en">Relation between two things which have a liquid exchange connection.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges liquid with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca líquido com</rdfs:label>
    </owl:ObjectProperty>
    


