        <dce:contributor xml:lang="en">Nicolau Santos</dce:contributor>
        <dce:creator xml:lang="en">Cauã Roca Antunes</dce:creator>
        <dcterms:description xml:lang="pt-br">Ontologia para descrever fluco de fluidos através de locais de instalação em instalações de indústria de transformação.</dcterms:description>
        <dcterms:description xml:lang="en">Ontology for describing fluid flow through functional locations in transformation industry installations.</dcterms:description>
        <dcterms:license rdf:resource="https://opensource.org/license/mit"/>
        <dcterms:title>Flow Linking Ontology of Wonders (FLOW)</dcterms:title>
        <owl:versionInfo>2026-11-09</owl:versionInfo>
    </owl:Ontology>
    


