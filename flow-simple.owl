    <!-- http://purl.obolibrary.org/obo/BFO_0000196 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000196"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000197 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000197"/>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000001 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000001">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000033"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between things that exchange electric charge, i.e. have electrical current between them.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges electricity with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca eletricidade com</rdfs:label>
        <annotation:adaptedFrom xml:lang="en">https://w3id.org/fso#exchangesElectricityWith</annotation:adaptedFrom>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000002 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000002">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000026"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a liquid exchange connection.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges liquid with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca líquido com</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000003 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000003">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000026"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a gas exchange connection.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges gas with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca gás com</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000004 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000004">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000003"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have an air exchange connection.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges air with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca ar com</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000005 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000005">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000003"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000027"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000006"/>
        <rdfs:comment xml:lang="en">Relation from a thing feeding gas to the thing it is feeding gas to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">alimenta gás para</rdfs:label>
        <rdfs:label xml:lang="en">feeds gas to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000006 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000006">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000003"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000028"/>
        <rdfs:comment xml:lang="en">Relation from a thing that is fed gas to the thing feeding the gas.</rdfs:comment>
        <rdfs:label xml:lang="en">has gas fed by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem gás alimentado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000007 -->

