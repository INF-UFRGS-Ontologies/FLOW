    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000017 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000017">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000033"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a logical connection (such as within a business process) but not necessarily a physical one.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">conectado logicamente a</rdfs:label>
        <rdfs:label xml:lang="en">logically connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000017"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:comment xml:lang="en">Relation between two things which have a signal exchange connection.</rdfs:comment>
        <rdfs:label xml:lang="en">exchanges signal with</rdfs:label>
        <rdfs:label xml:lang="pt-br">troca sinal com</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000019 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000019">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000020"/>
        <rdfs:comment xml:lang="en">Relation from a thing sending some signal to the thing it is sending signal to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">envia sinal para</rdfs:label>
        <rdfs:label xml:lang="en">sends signal to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000020 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000020">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000018"/>
        <rdfs:comment xml:lang="en">Relation from a thing that receives some signal to the thing sending the signal.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">recebe sinal de</rdfs:label>
        <rdfs:label xml:lang="en">receives signal from</rdfs:label>
    </owl:ObjectProperty>
    


