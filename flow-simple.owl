        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000029"/>
        <rdfs:comment xml:lang="en">Relation between a thing that has gas returned to it and the thing returning the gas.</rdfs:comment>
        <rdfs:label xml:lang="en">has gas returned by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem gás retornado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000010 -->

    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000010">
