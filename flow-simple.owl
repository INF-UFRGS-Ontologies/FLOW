        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000005"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000031"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000009"/>
        <rdfs:comment xml:lang="en">Relation between a thing that is returning gas to the thing it is returning gas to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">retorna gás para</rdfs:label>
        <rdfs:label xml:lang="en">returns gas to</rdfs:label>
    </owl:ObjectProperty>
    


