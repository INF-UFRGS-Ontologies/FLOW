        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000006"/>
        <rdfs:comment xml:lang="en">Relation from a thing that is fed air to the thing feeding the air.</rdfs:comment>
        <rdfs:label xml:lang="en">has air fed by</rdfs:label>
        <rdfs:label xml:lang="pt-br">tem ar alimentado por</rdfs:label>
