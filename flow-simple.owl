    <owl:Ontology rdf:about="https://www.inf.ufrgs.br/ontologies/flow/flow-simple.owl">
        <owl:versionIRI rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/releases/2026-11-09/flow-simple.owl"/>
        <dc:contributor xml:lang="en">Abel Correa Dias</dc:contributor>
        <dc:contributor xml:lang="en">Fabrício Henrique Rodrigues</dc:contributor>
        <dc:contributor xml:lang="en">Haroldo Rojas</dc:contributor>
        <dc:contributor xml:lang="en">Mara Abel</dc:contributor>
        <dc:contributor xml:lang="en">Nicolau Santos</dc:contributor>
        <dc:creator xml:lang="en">Cauã Roca Antunes</dc:creator>
        <terms:description xml:lang="pt-br">Ontologia para descrever fluco de fluidos através de locais de instalação em instalações de indústria de transformação.</terms:description>
        <terms:description xml:lang="en">Ontology for describing fluid flow through functional locations in transformation industry installations.</terms:description>
        <terms:license rdf:resource="https://opensource.org/license/mit"/>
        <terms:title>Flow Linking Ontology of Wonders (FLOW)</terms:title>
        <owl:versionInfo>2026-11-09</owl:versionInfo>
    </owl:Ontology>
    


