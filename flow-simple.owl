    <owl:ObjectProperty rdf:about="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000016">
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000010"/>
        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000012"/>
