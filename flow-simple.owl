        <rdfs:subPropertyOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000032"/>
        <owl:inverseOf rdf:resource="https://www.inf.ufrgs.br/ontologies/flow/FLOW_0000010"/>
        <rdfs:comment xml:lang="en">Relation between a thing that is supplying gas to the thing it is supplying gas to.</rdfs:comment>
        <rdfs:label xml:lang="pt-br">fornece gás para</rdfs:label>
        <rdfs:label xml:lang="en">supplies gas to</rdfs:label>
    </owl:ObjectProperty>
    


