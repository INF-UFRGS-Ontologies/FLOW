Prefix(flow:=<https://www.inf.ufrgs.br/ontologies/flow/>)
Prefix(dce:=<http://purl.org/dc/elements/1.1/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(dcterms:=<http://purl.org/dc/terms/>)
Prefix(obo:=<http://purl.obolibrary.org/obo/>)
Prefix(iof-av:=<https://spec.industrialontologies.org/ontology/annotation/>)
Prefix(ofl:=<https://www.inf.ufrgs.br/ontologies/ofl/>)


Ontology(<https://www.inf.ufrgs.br/ontologies/flow.owl>

Import(<https://www.inf.ufrgs.br/ontologies/flow/imports/bfo_import.owl>)
Import(<https://www.inf.ufrgs.br/ontologies/flow/imports/ofl_import.owl>)

Annotation(dce:contributor "Fabrício Henrique Rodrigues"@en)
Annotation(dce:contributor "Haroldo Rojas"@en)
Annotation(dce:contributor "Mara Abel"@en)
Annotation(dce:contributor "Nicolau Santos"@en)
Annotation(dce:contributor "Abel Correa Dias"@en)
Annotation(dce:creator "Cauã Roca Antunes"@en)


Annotation(dcterms:description "Ontology for describing fluid flow through functional locations in transformation industry installations."@en)
Annotation(dcterms:description "Ontologia para descrever fluco de fluidos através de locais de instalação em instalações de indústria de transformação."@pt-br)
Annotation(dcterms:license <https://opensource.org/license/mit>)
Annotation(dcterms:title "Flow Linking Ontology of Wonders (FLOW)")

Declaration(Class(flow:FLOW_0000021))
Declaration(Class(flow:FLOW_0000022))
