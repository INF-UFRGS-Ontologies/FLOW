                  rdfs:subPropertyOf flow:FLOW_0000033 ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:comment "Relation between things that exchange electric charge, i.e. have electrical current between them."@en ;
                  rdfs:label "exchanges electricity with"@en ,
                             "troca eletricidade com"@pt-br ;
                  iof-av:adaptedFrom "https://w3id.org/fso#exchangesElectricityWith"@en .


