                  rdfs:subPropertyOf flow:FLOW_0000026 ;
                  rdf:type owl:SymmetricProperty ;
                  rdfs:comment "Relation between two things which have a liquid exchange connection."@en ;
                  rdfs:label "exchanges liquid with"@en ,
                             "troca líquido com"@pt-br .


