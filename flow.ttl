                                                                "Fabrício Henrique Rodrigues"@en ,
                                                                "Haroldo Rojas"@en ,
                                                                "Mara Abel"@en ,
                                                                "Nicolau Santos"@en ;
                                                dce:creator "Cauã Roca Antunes"@en ;
                                                dcterms:description "Ontologia para descrever fluco de fluidos através de locais de instalação em instalações de indústria de transformação."@pt-br ,
                                                                    "Ontology for describing fluid flow through functional locations in transformation industry installations."@en ;
                                                dcterms:license <https://opensource.org/license/mit> ;
                                                dcterms:title "Flow Linking Ontology of Wonders (FLOW)" ;
                                                owl:versionInfo "2026-11-09" .

