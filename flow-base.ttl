obo:BFO_0000030 rdf:type owl:Class .


###  https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000021
flow:FLOW_0000021 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000030 ;
                  rdfs:label "objeto aberto ao fluxo"@pt-br ,
                             "open to flow object"@en ;
                  iof-av:naturalLanguageDefinition "def. a BFO:Object that is fully connected and allows fluid to flow through it."@en .


###  https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000022
flow:FLOW_0000022 rdf:type owl:Class ;
                  owl:equivalentClass [ owl:intersectionOf ( flow:FLOW_0000034
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty obo:BFO_0000196 ;
                                                               owl:someValuesFrom flow:FLOW_0000024
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                  rdfs:subClassOf flow:FLOW_0000021 ,
                                  flow:FLOW_0000034 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:BFO_0000196 ;
                                    owl:someValuesFrom flow:FLOW_0000024
                                  ] ;
                  rdfs:label "objeto de fluxo aberto"@pt-br ,
                             "open flow object"@en ;
                  iof-av:naturalLanguageDefinition "def. a FLOW:StateBasedFlowObject that is open and allows fluid to flow through it."@en .


###  https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000023
flow:FLOW_0000023 rdf:type owl:Class ;
                  rdfs:subClassOf [ owl:intersectionOf ( obo:BFO_0000019
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty obo:BFO_0000197 ;
                                                           owl:someValuesFrom flow:FLOW_0000034
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
                  rdfs:label "estado do objeto de fluxo"@pt-br ,
                             "flow object state"@en ;
                  iof-av:naturalLanguageDefinition "def. a BFO:Quality that is the open/closed state of a FLOW:StateBasedFlowObject."@en .


###  https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000024
flow:FLOW_0000024 rdf:type owl:Class ;
                  rdfs:subClassOf flow:FLOW_0000023 ;
                  owl:disjointWith flow:FLOW_0000025 ;
                  rdfs:label "estado aberto do objeto de fluxo"@pt-br ,
                             "flow object open state"@en ;
                  iof-av:naturalLanguageDefinition "def. a FLOW:FlowObjectState that is an open state."@en .


###  https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000025
flow:FLOW_0000025 rdf:type owl:Class ;
                  rdfs:subClassOf flow:FLOW_0000023 ;
                  rdfs:label "estado fechado do objeto de fluxo"@pt-br ,
                             "flow object closed state"@en ;
                  iof-av:naturalLanguageDefinition "def. a FLOW:FlowObjectState that is a closed state."@en .


###  https://www.inf.ufrgs.br/ontologies/FLOW/FLOW_0000034
flow:FLOW_0000034 rdf:type owl:Class ;
                  rdfs:subClassOf obo:BFO_0000030 ;
                  rdfs:label "objeto de fluxo baseado em estado"@pt-br ,
                             "state-based flow object"@en ;
                  iof-av:naturalLanguageDefinition "def. a BFO:Object that that is fully connected and may allow fluid to flow through it depending on its state."@en .


